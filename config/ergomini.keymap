#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB     &kp Q     &kp W     &kp E    &kp R  &kp T      &kp MINUS  &kp EQUAL  &kp Y      &kp U  &kp I      &kp O     &kp P     &kp BSPC
&kp CAPS    &kp A     &kp S     &kp D    &kp F  &kp G      &kp LBKT   &kp RBKT   &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z     &kp X     &kp C    &kp V  &kp B      &kp SPACE  &kp ENTER  &kp N      &kp M  &kp COMMA  &kp DOT   &kp UP    &kp FSLH
&kp LCTRL   &kp LWIN  &kp LALT  &kp DEL  &mo 1  &kp SPACE  &kp SPACE  &kp ENTER  &kp ENTER  &mo 1  &kp BSLH   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        lower_layer {
            bindings = <
&none  &kp EXCL   &kp AT     &kp HASH   &kp DOLLAR  &kp PERCENT  &none  &none  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &none
&none  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4   &kp KP_N5    &none  &none  &kp F1     &kp F2    &kp F3     &kp F4    &kp F5    &kp F6
&none  &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_N0    &none  &none  &kp F7     &kp F8    &kp F9     &kp F10   &kp F11   &kp F12
&none  &none      &none      &none      &none       &none        &none  &none  &none      &none     &none      &none     &none     &none
            >;
        };
    };
};
