#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1        &kp N2     &kp N3    &kp N4  &kp N5  &kp HOME    &kp END    &kp N6  &kp N7    &kp N8     &kp N9   &kp N0     &kp MINUS  &kp EQUAL
&kp TAB    &kp Q         &kp W      &kp E     &kp R   &kp T   &kp INSERT  &kp DEL    &kp Y   &kp U     &kp I      &kp O    &kp P      &kp LBKT   &kp RBKT
&kp CAPS   &kp A         &kp S      &kp D     &kp F   &kp G   &kp PG_UP   &kp PG_DN  &kp H   &kp J     &kp K      &kp L    &kp SEMI   &kp SQT    &kp BSLH
&kp LSHFT  &kp Z         &kp X      &kp C     &kp V   &kp B   &kp SPACE   &kp RET    &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH              &kp RIGHT_SHIFT
&kp LCTRL  &kp LEFT_WIN  &kp GRAVE  &kp LALT  &mo 1                                          &kp BSPC  &mo 1      &kp UP   &kp RIGHT  &kp DOWN   &kp LEFT
            >;
        };

        lower_layer {
            bindings = <
&none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none  &none        &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none  &none   &none   &none   &none   &none   &none  &none        &none   &none   &none   &none   &none    &none    &none
&none  &none   &none   &none   &none   &none   &none  &none        &none   &none   &none   &none   &none    &none    &none
&none  &none   &none   &none   &none   &none   &none  &bootloader  &none   &none   &none   &none   &none             &bt BT_CLR_ALL
&none  &none   &none   &none   &none                                       &none   &none   &none   &none    &none    &none
            >;
        };
    };
};
